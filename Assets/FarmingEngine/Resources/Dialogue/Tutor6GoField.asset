  lines:
  - speaker_name: Wizzy
    text: Sekarang kita bisa langsung pergi ke area berkebun
    portrait: {fileID: 21300000, guid: f1e613fcd198012459a5ae02e6cc9391, type: 3}
  - speaker_name: Wizzy
    text: Ha? kenapa tidak langsung menanam disini?
    portrait: {fileID: 21300000, guid: af935127c59fd3c4eb72e06cf12ad2c4, type: 3}
  - speaker_name: Wizzy
    text: Well ada sedikit masalah, kamu gak bakal mau mendengarkan yappinganku
    portrait: {fileID: 21300000, guid: af935127c59fd3c4eb72e06cf12ad2c4, type: 3}
  - speaker_name: Wizzy
    text: Just Biology and a little magic stuff
    portrait: {fileID: 21300000, guid: f1e613fcd198012459a5ae02e6cc9391, type: 3}
